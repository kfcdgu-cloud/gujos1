-- ปุ่ม 2: โหมดดินน้ำมันขั้นสุด (SmoothPlastic + Quality Level 1)
local isClayMode = false
local clayBtn
clayBtn = createMenuButton("โหมดดินน้ำมันแบบลื่นกริ๊บ: OFF", "🎨", function()
    isClayMode = not isClayMode
    clayBtn.Text = isClayMode and "  🎨  โหมดดินน้ำมันแบบลื่นกริ๊บ: ON" or "  🎨  โหมดดินน้ำมันแบบลื่นกริ๊บ: OFF"
    
    settings().Rendering.QualityLevel = isClayMode and 1 or 5
    
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = isClayMode and Enum.Material.SmoothPlastic or Enum.Material.Plastic
            v.CastShadow = not isClayMode
        elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Sparkles") or v:IsA("Smoke") or v:IsA("Fire") then
            v:Destroy()
        end
    end
end)

